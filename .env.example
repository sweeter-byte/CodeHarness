# Required: OpenAI-compatible model endpoint used by the runtime.
DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_BASE_URL=https://api.example.invalid/v1
DEEPSEEK_MODEL_ID=replace-with-your-model-id

# Optional runtime settings. Uncomment only when overriding the defaults.
# MODEL_CONTEXT_WINDOW=1048576
# WORKSPACE=/absolute/path/to/your/project
# CODEHARNESS_HOME=~/.codeharness
# MCP_CONFIG_PATH=~/.codeharness/mcp/servers.json
# GOAL_EVALUATOR_MODEL=replace-with-your-evaluator-model-id
